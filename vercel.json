{
  "installCommand": "bun install",
  "buildCommand": "cd client && bun install && bun run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
